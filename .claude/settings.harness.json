{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-haiku-5-5"
  },
  "model": "opus",
  "autoCompactWindow": 200000,
  "statusLine": {
    "type": "command",
    "command": "python3 -I ~/.claude/statusline.py",
    "padding": 0
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|Monitor|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.claude/hooks/main-readonly.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.claude/hooks/subagent-worktree.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task|TaskUpdate|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.claude/hooks/task-gate.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.claude/hooks/agent-names.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.claude/hooks/ready-gate.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.claude/hooks/agent-budget.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "ExitPlanMode|Agent|Task|TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.claude/hooks/plan-gate.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "TaskCreate|TaskUpdate|Agent|Task|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.claude/hooks/task-gate.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Write|Edit|MultiEdit|NotebookEdit|Bash|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.claude/hooks/session-repo.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.claude/hooks/plan-gate.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.claude/hooks/result-capture.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 -I ~/.claude/hooks/dispatch-stop.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.claude/hooks/review-record.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 -I ~/.claude/hooks/diagnose-record.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 -I ~/.claude/hooks/task-gate.py",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.claude/hooks/session-repo.py",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.claude/hooks/session-repo.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.claude/hooks/handoff-nudge.py",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.claude/hooks/local-mode.py",
            "timeout": 5
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.claude/hooks/session-repo.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "modelSettings": {
    "claude-haiku-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "qwen3.8:27b": {
      "effortLevel": "high"
    }
  }
}
