{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-haiku-5-5"
  },
  "autoCompactWindow": 150000,
  "statusLine": {
    "type": "command",
    "command": "python3 -I ~/.claude/statusline.py",
    "padding": 0
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.claude/hooks/main-readonly.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task|TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.claude/hooks/task-gate.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.claude/hooks/agent-names.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.claude/hooks/agent-budget.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "TaskCreate|TaskUpdate|Agent|Task|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.claude/hooks/task-gate.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Write|Edit|MultiEdit|NotebookEdit|Bash|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.claude/hooks/session-repo.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.claude/hooks/result-capture.py",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.claude/hooks/session-repo.py",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.claude/hooks/session-repo.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.claude/hooks/handoff-nudge.py",
            "timeout": 5
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ~/.claude/hooks/session-repo.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "modelSettings": {
    "claude-haiku-5-5": {
      "effortLevel": "medium"
    }
  }
}
