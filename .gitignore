# Allowlist: ignore everything at top level, then un-ignore the repo files and the harness dir
/*
!/.gitignore
!/README.md
!/deploy.sh
!/.claude/
!/tools/

# Inside .claude/: ignore everything, then un-ignore the shareable harness config only
/.claude/*
!/.claude/CLAUDE.md
!/.claude/settings.harness.json
!/.claude/keybindings.json
!/.claude/agents/
!/.claude/hooks/
!/.claude/commands/
!/.claude/scripts/
!/.claude/output-styles/
!/.claude/statusline*

# Re-ignore inside allowed dirs
.claude/hooks/state/
**/node_modules/
**/__pycache__/
*.pyc
*.bak*
*.log
*.jsonl
**/.env*
*.pem
*.key
**/renders/
**/*.png
**/*.jpg
**/tmp/
.claude/hooks/*.local.json
tools/**/out/

# Never track (explicit, belt and braces)
.credentials.json
settings.local.json
projects/
jobs/
todos/
history.jsonl
shell-snapshots/
statsig/
ide/
plugins/
cache/
session-env/
file-history/
sessions/
tasks/
daemon/
backups/
telemetry/
paste-cache/
plans/
feedback/
state/
