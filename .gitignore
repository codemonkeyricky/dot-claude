# Allowlist: ignore everything at top level, then un-ignore shareable config only
/*
!/.gitignore
!/README.md
!/deploy.sh
!/CLAUDE.md
!/settings.json
!/keybindings.json
!/agents/
!/hooks/
!/commands/
!/scripts/
!/output-styles/
!/statusline*

# Re-ignore inside allowed dirs
hooks/state/
**/node_modules/
**/__pycache__/
*.pyc
*.bak*
*.log
*.jsonl
**/.env*
*.pem
*.key
**/renders/
**/*.png
**/*.jpg
**/tmp/
hooks/*.local.json

# Never track (explicit, belt and braces)
.credentials.json
settings.local.json
projects/
jobs/
todos/
history.jsonl
shell-snapshots/
statsig/
ide/
plugins/
cache/
session-env/
file-history/
sessions/
tasks/
daemon/
backups/
telemetry/
paste-cache/
plans/
feedback/
state/
